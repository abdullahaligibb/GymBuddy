<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Trainingsübungen sicher bearbeiten" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fillColor=#FFFFFF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="210" y="10" width="330" height="45" as="geometry"/></mxCell><mxCell id="open" value="Training öffnen&lt;br&gt;unabhängigen Entwurf erstellen" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fillColor=#EEF4FF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="210" height="65" as="geometry"/></mxCell><mxCell id="edit" value="Übungen und Vorgaben ändern" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fillColor=#EEF4FF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="210" height="65" as="geometry"/></mxCell><mxCell id="validate" value="Speichern&lt;br&gt;vollständige Liste prüfen" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fillColor=#EEF4FF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="210" height="65" as="geometry"/></mxCell><mxCell id="invalid" value="Ungültige Eingabe&lt;br&gt;Fehler am Entwurf anzeigen" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fillColor=#FDECEC;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="320" y="330" width="210" height="65" as="geometry"/></mxCell><mxCell id="save" value="onSave mit geordneter Liste&lt;br&gt;auf Ergebnis warten" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#1F2937;fillColor=#EEF4FF;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="210" height="65" as="geometry"/></mxCell><mxCell id="failed" value="Speichern fehlgeschlagen&lt;br&gt;Entwurf behalten und erneut versuchen" style="rounded=1;whiteSpace=wrap