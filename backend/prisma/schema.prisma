generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Für Migrationen auf Supabase erforderlich
}

// -----------------------------------------
// 1. USER, KÖRPERDATEN & AUTH
// -----------------------------------------
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY   // Wenig Bewegung (Büro/Schule)
  LIGHT       // 1-2x Sport pro Woche
  MODERATE    // 3-4x Sport pro Woche
  ACTIVE      // 5-6x Sport pro Woche
  VERY_ACTIVE // Täglich intensives Training
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  currentStreak Int      @default(0)

  // Körper- & Zieldaten für die Makro-Berechnung (optional bei Registrierung)
  age            Int?
  gender         Gender?
  heightCm       Float?         // Grösse in cm
  weightKg       Float?         // Aktuelles Gewicht in kg
  targetWeightKg Float?         // Zielgewicht in kg
  targetDate     DateTime?      // Bis wann das Ziel erreicht werden soll
  activityLevel  ActivityLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Beziehungen
  trainingPlans  TrainingPlan[]
  workouts       Workout[]
  exercises      Exercise[]       // Eigene erstellte Übungen
  macroTarget    MacroTarget?     // 1:1 Berechnetes Tagesziel
  dailyMacroLogs DailyMacroLog[]  // 1:N Täglich eingetragene Makros
  healthProfile HealthProfile?
  revokedTokens RevokedToken[]
}

// -----------------------------------------
// 2. MAKROS (Ziele & Tägliches Tracking)
// -----------------------------------------
model MacroTarget {
  id        String   @id @default(uuid())
  calories  Int      // Ziel-Kalorien (kcal)
  protein   Int      // Ziel-Protein (g)
  carbs     Int      // Ziel-Kohlenhydrate (g)
  fat       Int      // Ziel-Fett (g)
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyMacroLog {
  id       String @id @default(uuid())
  date     String // Format YYYY-MM-DD
  calories Int    @default(0)
  protein  Int    @default(0)
  carbs    Int    @default(0)
  fat      Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Pro User und Datum genau ein Tages-Log (kann über den Tag hinweg addiert/aktualisiert werden)
  @@unique([userId, date])
}

// -----------------------------------------
// 3. TRAINING (TrainingPlan -> Workout -> Exercise)
// -----------------------------------------
enum WorkoutStatus {
  GEPLANT
  ERLEDIGT
  VERPASST
  RUHE
}

model TrainingPlan {
  id          String   @id @default(uuid())
  name        String   // z.B. "Push-Pull-Legs"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  clientId String?
  goal String @default("")
  durationMinutes Int @default(45)
  type String @default("Full Body")
  difficulty String @default("Mittel")
  muscles String[] @default([])

  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts Workout[]
  exercises PlanExercise[]
  @@unique([userId, clientId])
}

model Workout {
  id        String        @id @default(uuid())
  name      String        // z.B. "Oberkörper" oder "Push Day"
  date      String?       // Format YYYY-MM-DD für den Kalender
  duration  Int?          // Dauer in Minuten
  status    WorkoutStatus @default(GEPLANT)
  createdAt DateTime      @default(now())
  time String?
  type String @default("Full Body")
  intensity String @default("Mittel")
  muscles String[] @default([])
  notes String?
  sourceTemplateId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainingPlanId String?
  trainingPlan   TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)

  exercises WorkoutExercise[]
  @@unique([userId, date])
}

model Exercise {
  id               String   @id @default(uuid())
  externalId       String?  @unique // ID aus der ExerciseDB-API
  catalogId String? @unique
  name             String
  description      String?
  targetMuscles    String[]
  secondaryMuscles String[]
  equipments       String[]
  gifUrl           String?

  // null = globale Übung (z.B. aus ExerciseDB), gesetzt = eigene Übung des Users
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutExercises WorkoutExercise[]
  planExercises PlanExercise[]
}

model WorkoutExercise {
  id       String @id @default(uuid())
  position Int    // Reihenfolge im Workout (1, 2, 3...)
  sets     Int?
  reps     Int?
  weight   Float? // Gewicht in kg
  catalogId String?
  repetitions String?
  restSeconds Int?
  notes String?

  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([workoutId, exerciseId, position])
  @@unique([workoutId, position])
}

model PlanExercise {
  id String @id @default(uuid())
  trainingPlanId String
  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  catalogId String
  position Int
  sets Int
  repetitions String
  weight Float?
  restSeconds Int?
  notes String?
  @@unique([trainingPlanId, position])
}

model HealthProfile {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  birthDateIso String
  heightCm Float
  weightKg Float
  targetWeightKg Float
  targetDateIso String
  activityLevel String
  primaryGoal String
  experienceLevel String
  weeklyWorkoutGoal Int
  preferredTrainingDays String[]
  energyFormula String?
}

model RevokedToken {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
